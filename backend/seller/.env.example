# Seller's Hedera account ID (to receive payments)
# This is where payments will be sent to
# Create an account at: https://portal.hedera.com
HEDERA_ACCOUNT_ID=0.0.xxx

# Flight API key for live fares
FLIGHT_SERPAPI=YOUR_FLIGHT_API

# Server port
PORT=4021

# --- Escrow Contract Integration ---
# Set these after deploying HoldEscrow.sol to enable on-chain deposits

# HoldEscrow contract address (EVM format)
# Deploy with: cd contracts && npm run deploy:hedera
# HEDERA_ESCROW_ADDRESS=0x...

# Operator credentials for contract calls (same account that deploys)
# HEDERA_OPERATOR_ID=0.0.xxx
# HEDERA_OPERATOR_KEY=0x... (ECDSA private key)

# Network: testnet or mainnet
HEDERA_NETWORK=testnet

# --- Email Notifications (Resend) ---
# Get your API key at: https://resend.com
RESEND_API_KEY=re_xxxxx

# The "from" address for notification emails
EMAIL_FROM=agent@fly402.ai

# The base URL for deep links in emails (frontend URL)
APP_URL=http://localhost:5173
